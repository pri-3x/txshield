{
  "manifest_version": 3,
  "name": "TxShield",
  "version": "0.1.0",
  "description": "Checks transactions before your wallet opens: simulates them and warns about drainers, risky approvals, and failing transactions.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/lib.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "action": { "default_title": "TxShield settings", "default_popup": "src/options.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
