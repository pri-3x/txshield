# TxShield configuration. Copy to .env and adjust. All variables are optional
# unless noted. Never commit a .env containing real RPC API keys.

# --- RPC endpoints (operator-trusted) ---
# Comma-separated <chainId>=<url> (http/https only). URLs may embed API keys;
# they are redacted in logs and never returned by the API. Each endpoint's
# eth_chainId is verified against the configured chain ID.
# TXSHIELD_RPC_URLS=1=https://eth-mainnet.example/v2/KEY,11155111=https://sepolia.example/v2/KEY
# Allow API clients to pass their own RPC URL. Default false. When enabled:
# https only, public IPs only (checked at DNS and connect time), rpc-trace only.
# TXSHIELD_ALLOW_USER_RPC=false

# --- HTTP ---
# TXSHIELD_HTTP_ADDR=127.0.0.1:8080       # default: loopback only; ":8080" listens on all interfaces
# TXSHIELD_REQUEST_TIMEOUT=45s          # must be < TXSHIELD_HTTP_WRITE_TIMEOUT
# TXSHIELD_HTTP_WRITE_TIMEOUT=60s
# TXSHIELD_HTTP_READ_TIMEOUT=15s
# TXSHIELD_HTTP_READ_HEADER_TIMEOUT=5s
# TXSHIELD_HTTP_IDLE_TIMEOUT=120s
# TXSHIELD_SHUTDOWN_TIMEOUT=20s
# TXSHIELD_MAX_BODY_BYTES=1048576
# TXSHIELD_MAX_CALLDATA_BYTES=131072
# TXSHIELD_METRICS_PATH=/metrics

# --- Logging ---
# TXSHIELD_LOG_LEVEL=info               # debug | info | warn | error
# TXSHIELD_LOG_FORMAT=json              # json | text

# --- Persistence (optional; empty = stateless) ---
# TXSHIELD_DATABASE_URL=postgres://txshield:txshield@localhost:55432/txshield?sslmode=disable
# TXSHIELD_STORE_SENDER=false           # persist `from` addresses
# TXSHIELD_STORE_CALLDATA=false         # persist raw calldata (else hash + selector only)
# TXSHIELD_RETENTION_DAYS=30            # 0 = keep forever
# TXSHIELD_DB_MAX_CONNS=10

# --- Cache (optional) ---
# TXSHIELD_REDIS_URL=redis://localhost:6379/0

# --- Engine ---
# TXSHIELD_REPUTATION_FILES=configs/reputation/example-blocklist.json
# TXSHIELD_SCORING_CONFIG=                  # JSON overrides, see docs/risk-scoring.md

# --- API protection ---
# TXSHIELD_API_KEYS=                        # comma-separated, >= 24 chars each; empty = no auth
# TXSHIELD_RATE_LIMIT_RPS=5                 # per client IP on /api/ routes; 0 disables
# TXSHIELD_RATE_LIMIT_BURST=20
# TXSHIELD_TRUST_PROXY_HEADERS=false        # use last X-Forwarded-For hop (only behind a proxy)
# TXSHIELD_CORS_ORIGINS=http://localhost:3000

# --- Dashboard (docker compose) ---
# TXSHIELD_DASHBOARD_API_KEY=              # must match one of TXSHIELD_API_KEYS when keys are enabled
# TXSHIELD_DASHBOARD_BASIC_AUTH=           # user:password (password >= 16 chars); required before exposing the dashboard

# --- Simulation ---
# TXSHIELD_SIMULATOR=anvil                  # anvil | rpc-trace | none
# TXSHIELD_ANVIL_PATH=anvil
# TXSHIELD_SIMULATION_TIMEOUT=30s
# TXSHIELD_SIMULATION_MAX_CONCURRENT=4
